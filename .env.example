# .env.example - Copy to .env and fill in your values
# NEVER commit .env with real secrets!

# https://www.builder.io/c/docs/using-your-api-key
VITE_PUBLIC_BUILDER_KEY=__BUILDER_PUBLIC_KEY__

# Builder.io music assets API key
# Generate from https://app.builder.io/account/space
# This key was exposed in GitHub until April 2026 - rotate immediately!
VITE_BUILDER_MUSIC_API_KEY=YOUR_NEW_API_KEY_HERE

# Demo ping message
PING_MESSAGE="ping pong"
